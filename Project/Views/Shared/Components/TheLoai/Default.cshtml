@model IEnumerable<TheLoai>
<div class="nav-item dropdown">
    <a  class="nav-link dropdown-toggle" data-bs-toggle="dropdown">SanPham</a>
    <div class="dropdown-menu rounded-0 m-0">
        @foreach (var item in Model)
        {
            <a class="dropdown-item" asp-action="FilterByTheLoai"
            asp-route-id="@item.Id">@item.Name</a>
            
        }
        
    </div>
</div>


